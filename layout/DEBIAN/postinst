#!/bin/sh
# Register the app and its iMessage / keyboard extensions with LaunchServices.
if [ -x /var/jb/usr/bin/uicache ]; then
	/var/jb/usr/bin/uicache -p /var/jb/Applications/Stickers.app >/dev/null 2>&1 || true
fi
# Sticker library: inside the jailbreak root so Messages and other sandboxed apps can read it.
mkdir -p /var/jb/var/mobile/Library/Stickers
chown mobile:mobile /var/jb/var/mobile/Library/Stickers
exit 0
